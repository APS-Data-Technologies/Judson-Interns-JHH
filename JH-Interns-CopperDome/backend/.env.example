# Copy to backend/.env and fill in. This file is committed; .env is not.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required when DEBUG=False — the app refuses to start on the placeholder.
DJANGO_SECRET_KEY=replace-me
DEBUG=True

# Set DB_ENGINE=sqlite3 for a local run with no Postgres.
DB_ENGINE=postgresql
POSTGRES_DB=copperdome_dev
POSTGRES_USER=copperdome_user
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API. The Vite dev proxy makes the frontend same-origin
# locally, but docker-compose and the Railway deploy serve it from a different origin.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server-side only — never exposed to the client bundle (scope 5.4).
# Leave blank to run the concierge in its menu-grounded stub mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Set to use Redis for the staff feed instead of the in-memory channel layer.
# Required if the backend ever runs more than one process.
REDIS_URL=
